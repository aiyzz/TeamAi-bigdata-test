{
  "meta_info": {
    "mode": "double_table",
    "table_name": "bigdata_app.app_close_ring_total_d",
    "detail_table_name": "bigdata_app.app_close_ring_detail_d",
    "partition_field": "rpt_date"
  },
  "detail_summary_mapping": {
    "join_keys": ["rpt_date", "org_code", "team", "groups", "emp_code", "first_tab_type", "second_tab_type", "third_tab_type", "layer_type"],
    "filter_dimensions_join": {
      "sum_type": {
        "D": "day",
        "M": "month", 
        "Y": "year"
      },
      "first_tab_type": {
        "1": "all",
        "2": "work_time",
        "3": "non_work_time"
      }
    },
    "metric_mapping": [
      {
        "summary_field": "should_close_ring_num",
        "detail_aggregation": "COUNT(*)",
        "detail_condition": "should_close_flag = 1"
      },
      {
        "summary_field": "close_ring_num",
        "detail_aggregation": "COUNT(*)",
        "detail_condition": "close_ring_flag = 1"
      },
      {
        "summary_field": "deal_num",
        "detail_aggregation": "COUNT(*)",
        "detail_condition": "deal_flag = 1"
      },
      {
        "summary_field": "should_over_num",
        "detail_aggregation": "COUNT(*)",
        "detail_condition": "should_overdue_flag = 1"
      }
    ],
    "group_by_mapping": ["rpt_date", "sum_type", "org_code", "org_name", "org_type", "team", "groups", "emp_code", "emp_name", "first_tab_type", "second_tab_type", "third_tab_type", "layer_type"]
  },
  "dimension_definitions": {
    "org_hierarchy": {
      "order": ["HEAD", "TEAM", "GROUPS", "EMP"]
    },
    "time_granularity": {
      "order": ["D", "M", "Y"]
    },
    "tab_type_hierarchy": {
      "first": "first_tab_type",
      "second": "second_tab_type", 
      "third": "third_tab_type"
    }
  },
  "metric_definitions": [
    {"code": "should_close_ring_num", "base_aggregation": "SUM", "data_type": "INT"},
    {"code": "close_ring_num", "base_aggregation": "SUM", "data_type": "INT"},
    {"code": "close_ring_rate", "base_aggregation": "AVG", "data_type": "DECIMAL"},
    {"code": "deal_num", "base_aggregation": "SUM", "data_type": "INT"},
    {"code": "deal_ring", "base_aggregation": "SUM", "data_type": "INT"},
    {"code": "should_over_num", "base_aggregation": "SUM", "data_type": "INT"},
    {"code": "timely_deal_rate", "base_aggregation": "AVG", "data_type": "DECIMAL"}
  ],
  "hierarchy_logic": [
    {
      "target_level": "EMP",
      "calculation_method": "COMPARE_DETAIL_SUMMARY",
      "description": "验证客服级明细与汇总一致性",
      "source_definition": {
        "org_levels": ["EMP"]
      },
      "aggregation_granularity": {
        "group_by_fields": ["rpt_date", "sum_type", "org_code", "team", "groups", "emp_code", "first_tab_type", "second_tab_type", "third_tab_type", "layer_type"]
      }
    },
    {
      "target_level": "GROUPS",
      "calculation_method": "ROLLUP_SUM",
      "description": "班组级向上汇总校验",
      "source_definition": {
        "org_levels": ["EMP", "GROUPS"]
      },
      "aggregation_granularity": {
        "group_by_fields": ["rpt_date", "sum_type", "org_code", "team", "groups", "first_tab_type", "second_tab_type", "third_tab_type", "layer_type"]
      }
    },
    {
      "target_level": "TEAM",
      "calculation_method": "ROLLUP_SUM",
      "description": "团队级向上汇总校验",
      "source_definition": {
        "org_levels": ["EMP", "GROUPS", "TEAM"]
      },
      "aggregation_granularity": {
        "group_by_fields": ["rpt_date", "sum_type", "org_code", "team", "first_tab_type", "second_tab_type", "third_tab_type", "layer_type"]
      }
    },
    {
      "target_level": "HEAD",
      "calculation_method": "ROLLUP_SUM",
      "description": "总部级向上汇总校验",
      "source_definition": {
        "org_levels": ["EMP", "GROUPS", "TEAM", "HEAD"]
      },
      "aggregation_granularity": {
        "group_by_fields": ["rpt_date", "sum_type", "org_code", "first_tab_type", "second_tab_type", "third_tab_type", "layer_type"]
      }
    }
  ],
  "validation_thresholds": {
    "diff_threshold": 0.1,
    "rate_threshold": 0.05
  }
}
